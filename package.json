{
  "name": "cast-year",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "account:import": "yarn workspace @faralytics/contracts account:import",
    "dev": "node scripts/web.cjs dev",
    "build": "node scripts/web.cjs build",
    "start": "node scripts/web.cjs start",
    "lint": "yarn workspace @cast-year/web lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "vercel:build": "vercel build --prod --yes",
    "vercel:deploy": "vercel deploy --prebuilt --prod",
    "deploy": "yarn workspace @faralytics/contracts deploy",
    "db:migrate": "node scripts/db-migrate.cjs",
    "logs:lookups": "node scripts/lookup-logs.cjs"
  }
}
