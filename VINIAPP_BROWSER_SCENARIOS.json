{
  "scenarios": [
    {
      "name": "lookup-and-year",
      "path": "/",
      "viewport": "mobile",
      "steps": [
        {
          "probe": "/api/health/db",
          "expect": 200
        },
        {
          "probe": "/api/activity?user=366713",
          "expect": 200
        },
        {
          "action": "fill",
          "test_id": "lookup-input",
          "value": "366713"
        },
        {
          "action": "click",
          "test_id": "lookup-submit"
        },
        {
          "assert": "visible",
          "test_id": "activity-graph"
        },
        {
          "action": "click",
          "test_id": "year-2025"
        },
        {
          "assert": "visible",
          "test_id": "activity-total"
        },
        {
          "assert": "visible",
          "test_id": "share-farcaster"
        },
        {
          "assert": "fits",
          "test_id": "share-x"
        }
      ]
    },
    {
      "name": "search-suggestions",
      "path": "/",
      "viewport": "mobile",
      "steps": [
        {
          "probe": "/api/search?q=366713",
          "expect": 200
        },
        {
          "action": "fill",
          "test_id": "lookup-input",
          "value": "366713"
        },
        {
          "assert": "visible",
          "test_id": "search-dropdown"
        },
        {
          "action": "click",
          "test_id": "search-result"
        },
        {
          "assert": "visible",
          "test_id": "activity-graph"
        }
      ]
    }
  ]
}
