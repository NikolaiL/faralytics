# Required: HTTPS read-only Farcaster ClickHouse endpoint. Server only.
CLICKHOUSE_URL=
# Required: read-only database user. Server only.
CLICKHOUSE_USER=
# Required: reader password. Server only; never sent to browsers.
CLICKHOUSE_PASSWORD=
# Required: complete PEM certificate with literal \n separators. TLS verification stays enabled.
CLICKHOUSE_CA_CERT=
# Optional locally; required publicly: canonical app origin used for share metadata.
NEXT_PUBLIC_URL=
# Optional for public Farcaster registration: signed account association from the developer tool.
FARCASTER_ACCOUNT_ASSOCIATION=
